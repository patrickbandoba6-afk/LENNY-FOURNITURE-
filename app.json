{
  "expo": {
    "name": "LENNY-FOURNITURE",
    "slug": "lenny-fourniture",
    "scheme": "lennyfourniture",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/logo.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lennyfourniture.app"
    },
    "android": {
      "package": "com.lennyfourniture.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
