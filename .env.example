# Copy this file to .env and fill in your own Supabase project credentials.
# Never commit the real .env file or put secret/service-role keys in the
# mobile app — only the public URL and anon key belong here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
