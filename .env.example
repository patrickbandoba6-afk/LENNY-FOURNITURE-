# Copie ce fichier en .env et renseigne tes propres valeurs.
# Ne jamais committer .env ni de clé secrète dans l'application mobile.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optionnel - activé uniquement quand un fournisseur d'IA est branché.
# En son absence, AIProvider bascule automatiquement en mode développement (réponses simulées).
EXPO_PUBLIC_AI_PROVIDER=
